@startuml classes_visao_geral
!pragma layout smetana
!include _estilo.iuml
title Visão geral: as cinco camadas e as classes centrais
hide empty members

package "xadrez.ui" as ui {
  class App {
    +scene: Scene
    +account: str | None
    +step(dt)
  }
  abstract class Scene {
    {abstract} +update(dt)
    {abstract} +draw(surface)
  }
  class ArenaScene
  class LoginScene
  class MenuScene
  class LobbyScene
  class GameScene {
    +hides_hints: bool
    +handle_event(event)
  }
  class GameOverScene
  class BoardView {
    +start_move(outcome)
    +pick(position)
  }
  class Hud
  class CpuPlayer {
    +start(board, remaining, increment)
    +poll(dt)
  }
  class NetMatch {
    +receive_events()
    +publish_result()
  }
}

package "xadrez.core" as core {
  class GameEngine {
    +state: GameState
    +play(origin, target, promotion)
    +tick(dt)
  }
  class Board {
    +turn: Color
    +apply(move)
    +undo()
    +copy()
  }
  abstract class Piece {
    +color: Color
    {abstract} +attacks(board, square)
  }
  class Player {
    +name: str
    +match_points: float
  }
  class ai <<module>> {
    +choose_move(board, difficulty, ...)
  }
}

package "xadrez.graphics" as graphics {
  class Camera {
    +project(points)
    +screen_ray(sx, sy)
  }
  class Renderer3D {
    +add_mesh(mesh, matrix, color)
    +flush()
  }
  class ParticleSystem {
    +emit(position, count, ...)
    +update(dt)
  }
  class ColorMatrix {
    +rgb(time)
  }
  class PieceAnimation {
    +model_matrix()
  }
  class Vector2D {
    +x: float
    +y: float
    +reflect(normal)
  }
}

package "xadrez.data" as data {
  class AccountStore {
    +create(username, password)
    +authenticate(username, password)
  }
  class HistoryStore {
    +add(record)
    +records()
  }
}

package "xadrez.net" as net {
  class HostSession {
    +send_result(result, plies)
  }
  class ClientSession
}

App *-- "1$p" Scene
Scene <|-- ArenaScene
ArenaScene <|-- LoginScene
ArenaScene <|-- MenuScene
ArenaScene <|-- LobbyScene
Scene <|-- GameScene
Scene <|-- GameOverScene
GameScene *-- "1$p" Hud
GameScene o-- "1$p" BoardView
GameOverScene o-- "1$p" BoardView
GameScene *-- "0..1$p" CpuPlayer
GameScene *-- "0..1$p" NetMatch

GameScene -- "1$p" GameEngine
GameEngine *-- "1$p" Board
GameEngine *-- "2$p" Player
Board *-- "0..64$p" Piece
CpuPlayer ..> ai

BoardView *-- "1$p" Camera
BoardView *-- "1$p" Renderer3D
BoardView *-- "1$p" ColorMatrix
BoardView *-- "1$p" ParticleSystem
BoardView *-- "0..2$p" PieceAnimation
PieceAnimation *-- "3$p" Vector2D

LoginScene ..> AccountStore
GameScene ..> HistoryStore
NetMatch ..> HostSession
NetMatch ..> ClientSession

note bottom of core
  ui usa todas as camadas.
  core e graphics não conhecem ninguém.
  net usa só core. data e net não se importam
  (tests/test_arquitetura.py).
end note
@enduml
