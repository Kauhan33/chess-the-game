@startuml classes_ui_cenas
!pragma layout smetana
!include _estilo.iuml
title Camada ui: aplicação e cenas
hide empty members

class App {
  +screen: Surface
  +size: tuple
  +pacer: FramePacer
  +theme: Theme
  +meshes: dict
  +tableau: Tableau
  +require_login: bool
  +network
  +account: str | None
  +running: bool
  +fps: float
  +frame_ms: float
  +scene: Scene
  --
  +history_store(): HistoryStore | None
  +login_scene(start_creating=False)
  +menu_scene(defaults=None)
  +lobby_scene(options, role)
  +game_scene(engine, options, view, local_player, link)
  +game_over_scene(engine, options, view, local_player, link)
  +step(dt)
  +run_frame()
  +preload()
  +run()
  -_dispatch(event)
  -_apply_scene_change()
}

class FramePacer {
  +period: float
  +fps: float
  --
  +wait(): float
}

abstract class Scene {
  +app: App
  +next_scene: Scene | None
  --
  {abstract} +handle_event(event)
  {abstract} +update(dt)
  {abstract} +draw(surface)
  {abstract} +resize(size)
  +shutdown()
}

class ArenaScene

class MenuScene {
  +options(): MatchOptions
  +start_match()
}

class LoginScene

class LobbyScene

class GameScene {
  +engine: GameEngine
  +options: MatchOptions
  +view: BoardView
  +local_player: Player
  +hides_hints: bool
  +auto_rotate: bool
  +cpu: CpuPlayer | None
  +net: NetMatch | None
  +selection: Square | None
  +targets: dict[Square, Move]
  +cursor: Cell | None
  +modals: list[Overlay]
  +notices: NoticeBar
  +hud: Hud
  +is_board_locked: bool
  +is_frozen: bool
  --
  +open_pause()
  +open_help()
  +confirm_restart()
  +restart()
  +copy_pgn()
  +flip_board()
  +shutdown()
  -_press_square(position)
  -_drop_piece(origin, cell)
  -_compute_alerts()
  -_activate_square(cell)
  -_submit_move(origin, target, promotion)
  -_refuse(error, square)
  -_show_move(outcome)
  -_begin_turn()
  -_begin_ending(result)
  -_advance_ending(dt)
  -_paint_highlights()
}

class GameOverScene {
  +engine: GameEngine
  +options: MatchOptions
  +view: BoardView
  +result: GameResult
  +rematch_button: Button
  +menu_button: Button
  +copy_button: Button
  +link: NetLink | None
  +focus: FocusGroup
  --
  +rematch()
  +go_to_menu()
  +copy_pgn()
}

enum GameMode {
  TRAINING
  MATCH
  +label: str
  +description: str
}

class MatchOptions <<frozen>> {
  +white_name: str
  +black_name: str
  +time_control: TimeControl
  +auto_rotate: bool
  +mode: GameMode
  +opponent_kind: str
  +difficulty: Difficulty
  +human_color: Color | None
  +is_local: bool
  +cpu_name: str
  --
  +create_engine(fen, human_color): GameEngine
}

class GameEngine
class BoardView

App *-right- "1$p" Scene : cena atual
App *-- "1$p" FramePacer
Scene <|-- ArenaScene
ArenaScene <|-- MenuScene
ArenaScene <|-- LoginScene
ArenaScene <|-- LobbyScene
Scene <|-- GameScene
Scene <|-- GameOverScene
GameScene o-- "1$p" BoardView
GameOverScene o-- "1$p" BoardView
GameScene -- "1$p" GameEngine
GameOverScene -- "1$p" GameEngine
MenuScene ..> MatchOptions : cria
MatchOptions ..> GameEngine : cria
MatchOptions -- "1$p" GameMode
GameScene ..> MatchOptions : lê
@enduml
